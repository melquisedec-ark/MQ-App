*.zip

# SQLite temporary files
*.db-shm
*.db-wal

# Runtime database files (generated in Fase 2).
# NOTA: `biblia.db` y `mqapp.db` se trackean explícitamente porque son
# assets de Flutter embebidos en runtime. El usuario los edita directamente
# desde la app en debug mode (flutter run -d linux).
assets/db/*.db
assets/db/*.db-journal
assets/db/*.db-wal
assets/db/*.db-shm
!assets/db/.gitkeep
!assets/db/biblia.db
!assets/db/mqapp.db

# Coverage reports
coverage/

# Cross-references (v1.0.3+) — archivos grandes generados en build-time
# Dataset: 8.3 MB (openbible.info)
# Seed SQL: ~27 MB (340k INSERTs)
# Estos se regeneran con `dart run assets/db/tools/generate_cross_references_seed.dart`
assets/db/tools/source/scrollmapper/cross_references.txt
assets/db/seed_cross_referencias_rv1909.sql
